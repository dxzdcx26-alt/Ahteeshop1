generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   @default("user")
  balance   Float    @default(0)
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions  Session[]
  orders    Order[]
  topups    TopupRequest[]
  transactions Transaction[]
  spins     WheelSpin[]
  messages  InboxMessage[]
  appOrders AppOrder[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  name      String
  detail    String   @default("")
  image     String   @default("")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  products  Product[]
}

model Product {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  detail      String   @default("")
  image       String   @default("")
  price       Float    @default(0)
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  hubzellServiceId String @default("")
  hubzellProductId String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       ProductItem[]
  orders      Order[]
}

model ProductItem {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  payload   String
  sold      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Order {
  id          String   @id @default(cuid())
  orderNo     String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  unitPrice   Float
  total       Float
  payloads    String   @default("")
  status      String   @default("success")
  hubzellClientRef     String @default("")
  hubzellTransactionId String @default("")
  hubzellStatus        String @default("")
  createdAt   DateTime @default(now())
}

model TopupRequest {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Float
  method     String   @default("promptpay")
  reference  String   @default("")
  status     String   @default("pending")
  adminNote  String   @default("")
  createdAt  DateTime @default(now())
  processedAt DateTime?
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  amount    Float    @default(0)
  detail    String   @default("")
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  text      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model WheelPrize {
  id      String @id @default(cuid())
  wheel   Wheel @relation(fields: [wheelId], references: [id], onDelete: Cascade)
  wheelId String
  label   String
  type    String @default("none")
  value   Float  @default(0)
  weight  Int    @default(10)
  color   String @default("#d4af37")
  sortOrder Int  @default(0)
}

model Wheel {
  id        String   @id @default(cuid())
  name      String
  image     String   @default("")
  cost      Float    @default(0)
  currency  String   @default("balance")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  prizes    WheelPrize[]
  spins     WheelSpin[]
}

model WheelSpin {
  id        String   @id @default(cuid())
  wheelId   String
  wheel     Wheel    @relation(fields: [wheelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prize     String
  type      String   @default("none")
  value     Float    @default(0)
  createdAt DateTime @default(now())
}

model InboxMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @default("")
  raw       String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RedeemCode {
  id        String   @id @default(cuid())
  code      String   @unique
  amount    Float
  usedBy    String   @default("")
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  usedAt    DateTime?
}

model AppProduct {
  id        String   @id @default(cuid())
  extId     Int      @unique
  name      String
  image     String   @default("")
  price     Float    @default(0)
  stock     Int      @default(0)
  detail    String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    AppOrder[]
}

model AppOrder {
  id          String   @id @default(cuid())
  orderNo     String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId       String
  app         AppProduct @relation(fields: [appId], references: [id])
  appName     String
  total       Float
  payload     String   @default("")
  status      String   @default("success")
  createdAt   DateTime @default(now())
}

model RewardItem {
  id        String   @id @default(cuid())
  name      String
  detail    String   @default("")
  image     String   @default("")
  pointsCost Int     @default(0)
  stock     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
